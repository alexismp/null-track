# Clé API IDFM PRIM (gratuite sur https://prim.iledefrance-mobilites.fr/)
PRIM_API_KEY=votre_cle_api_prim_ici

# Plage horaire de surveillance (ex: 07h00 - 09h30)
START_HOUR=7
START_MINUTE=0
END_HOUR=9
END_MINUTE=30

# Jours surveillés (0=Lundi, 1=Mardi, 2=Mercredi, 3=Jeudi, 4=Vendredi)
ACTIVE_DAYS=0,1,2,3,4

# ID du projet Firebase / GCP (pour Firestore et Cloud Messaging)
FIREBASE_PROJECT_ID=votre-projet-gcp-id

# Nom du topic FCM
FCM_TOPIC=trains_meudon_montparnasse

# Forcer la vérification même hors horaires (utile pour tests)
FORCE_CHECK=false
